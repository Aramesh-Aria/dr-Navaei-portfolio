# Copy to .env and fill in. .env itself is gitignored — never commit real secrets.

SECRET_KEY=change-me

# Which settings to use: config.settings.dev or config.settings.prod.
# Unset: manage.py uses dev, wsgi.py/asgi.py (gunicorn) use prod.
# On Runflare set config.settings.prod, or manage.py migrate runs on dev settings.
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- config.settings.dev only (prod always has DEBUG off) ---
# Empty means on. Set to false to try production-like serving locally.
DEBUG=

# --- config.settings.prod only ---
ALLOWED_HOSTS=dr.safanavaiee.ir,www.dr.safanavaiee.ir,localhost,127.0.0.1
DATABASE_PATH=/app/database/db.sqlite3
# Email provider not picked yet — leave EMAIL_* empty; notifications are skipped.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
INQUIRY_NOTIFICATION_EMAIL=
